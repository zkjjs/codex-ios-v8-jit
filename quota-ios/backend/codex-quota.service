[Unit]
Description=Read-only Codex quota service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/codex-quota
EnvironmentFile=/etc/codex-quota.env
ExecStart=/usr/bin/python3 /opt/codex-quota/quota_service.py --port 18427
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
