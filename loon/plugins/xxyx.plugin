[Script]
http-response ^https:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com/my(?:\?|$) script-path=https://raw.githubusercontent.com/zkjjs/codex-ios-v8-jit/loon-scripts/loon/scripts/xxyx.js,requires-body=true,timeout=15,tag=晓晓优选获取账号
cron "15 8 * * *" script-path=https://raw.githubusercontent.com/zkjjs/codex-ios-v8-jit/loon-scripts/loon/scripts/xxyx.js,timeout=300,tag=晓晓优选每日任务

[MITM]
hostname = xxyx-client-api.xiaoxiaoyouxuan.com
